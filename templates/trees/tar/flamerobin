#!/bin/sh
# Starts FlameRobin from wherever this tree was extracted or installed.
# Resolves symlinks, so it can be linked into ~/.local/bin or /usr/local/bin.
HERE=$(dirname "$(readlink -f "$0")")
export FR_HOME="${FR_HOME:-${HERE}/share/flamerobin}"
export LD_LIBRARY_PATH="${HERE}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
exec "${HERE}/bin/flamerobin" "$@"
