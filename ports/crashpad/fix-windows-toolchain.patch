+def _GenerateEnvironmentFiles(install_dir, out_dir, script_path,
+                              target_cpu=None):
+    """Extracts MSVC environment variables for the requested target_cpu (or all
+    supported architectures when unspecified) without failing if optional
+    cross-architectures such as arm64 are not installed."""
+    all_archs = ('x86', 'amd64', 'arm64')
+    requested = (target_cpu or os.environ.get('VCPKG_CRASHPAD_TARGET_CPU') or
+                 '').lower()
+    if requested == 'x86':
+        archs_to_probe = ('x86',)
+    elif requested in ('x64', 'amd64'):
+        archs_to_probe = ('amd64',)
+    elif requested == 'arm64':
+        archs_to_probe = ('arm64',)
+    else:
+        archs_to_probe = all_archs
+
+    env_by_arch = {}
+    fallback_env = None
+    for arch in archs_to_probe:
+        if script_path.endswith('SetEnv.cmd'):
+            candidates = {
+                'x86': ['/x86'],
+                'amd64': ['/x64'],
+                'arm64': ['/arm64'],
+            }[arch]
+        else:
+            candidates = {
+                'x86': ['x86', 'amd64_x86'],
+                'amd64': ['amd64', 'x86_amd64'],
+                'arm64': ['amd64_arm64', 'arm64', 'x86_arm64'],
+            }[arch]
+
+        extracted = None
+        last_rc = 1
+        last_out = b''
+        for script_arch_name in candidates:
+            rc, variables = _RunEnvScript(install_dir, script_path,
+                                          script_arch_name)
+            last_rc = rc
+            last_out = variables
+            if rc == 0:
+                extracted = _ExtractImportantEnvironment(variables)
+                break
+
+        if extracted is None:
+            if not requested and fallback_env is not None and arch == 'arm64':
+                extracted = fallback_env
+            else:
+                raise Exception('"%s %s" failed with error %d:\n%s' %
+                                (os.path.join(install_dir, script_path),
+                                 candidates[0], last_rc,
+                                 _DecodeBytes(last_out)))
+
+        env_by_arch[arch] = extracted
+        if fallback_env is None:
+            fallback_env = extracted
+
+    for arch in all_archs:
+        if arch not in env_by_arch:
+            env_by_arch[arch] = fallback_env
+
+    return _WriteEnvironmentFiles(out_dir, env_by_arch)
+
