+def _RunEnvScript(install_dir, script_path, script_arch_name):
+    full_script = os.path.normpath(os.path.join(install_dir, script_path))
+    if sys.platform == 'win32':
+        comspec = os.environ.get('COMSPEC', 'cmd.exe')
+        cmdline = '"%s" /d /s /c ""%s" %s && set"' % (
+            comspec, full_script, script_arch_name)
+        popen = subprocess.Popen(cmdline,
+                                 shell=False,
+                                 stdout=subprocess.PIPE,
+                                 stderr=subprocess.STDOUT)
+    else:
+        popen = subprocess.Popen([full_script, script_arch_name],
+                                 shell=False,
+                                 stdout=subprocess.PIPE,
+                                 stderr=subprocess.STDOUT)
+    variables, _ = popen.communicate()
+    return popen.returncode, variables
+
