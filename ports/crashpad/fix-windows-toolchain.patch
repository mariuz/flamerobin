+def _ExtractCurrentEnvironment():
+    """Extracts the MSVC toolchain environment directly from os.environ when
+    already initialized by vcpkg."""
+    envvars_to_save = (
+        'include',
+        'lib',
+        'libpath',
+        'path',
+        'pathext',
+        'systemroot',
+        'temp',
+        'tmp',
+        'vslang',
