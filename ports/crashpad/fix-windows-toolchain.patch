+def _DecodeBytes(data):
+    """Decodes subprocess byte output without failing on localized Windows
+    OEM/ANSI code pages (e.g. CP850/CP1252 umlauts)."""
+    if isinstance(data, str):
+        return data
+    encodings = ['utf-8']
+    if sys.platform == 'win32':
+        encodings.extend(['mbcs', 'oem'])
+    for enc in encodings:
+        try:
+            return data.decode(enc)
+        except (UnicodeDecodeError, LookupError):
+            pass
+    return data.decode('utf-8', errors='replace')
+
+
+def _EnvFileEncoding():
+    """Encoding used for Ninja's -t msvc -e environment block files
+    (CreateProcessA ANSI block on Windows)."""
+    return 'mbcs' if sys.platform == 'win32' else 'utf-8'
+
